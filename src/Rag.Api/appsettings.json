{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "Provider": "Ollama",
    "Ollama": {
      "Uri": "http://localhost:11434",
      "ChatModel": "gemma4:12b",
      "EmbeddingModel": "nomic-embed-text"
    },
    "Gemini": {
      "ChatModel": "gemini-2.5-flash",
      "EmbeddingModel": "gemini-embedding-001"
    },
    "SamplesPath": "../../samples/candidate",
    "Limits": {
      "SessionMinutes": 60,
      "MaxSessions": 100,
      "MaxFiles": 3,
      "MaxFileBytes": 2097152,
      "MaxDocumentChars": 40000,
      "MaxJobAdChars": 10000,
      "DailyAiRequests": 300,
      "UploadsPerHour": 10,
      "SearchesPerHour": 100,
      "MatchesPerHour": 20
    }
  }
}
